# Vercel Production Environment Variables
# These should be set in Vercel Dashboard: https://vercel.com/dashboard/project/settings/environment-variables

# Upstash Redis (Required for @vercel/kv)
# Get from: https://vercel.com/integrations/upstash
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: Gemini API (for AI features)
GEMINI_API_KEY=
